#!/usr/bin/env expect
set timeout 5

set environment [lindex $argv 0]
set provider [lindex $argv 1]
set message "Command exited before an interactive session was ready. Press Enter to close."

spawn -noecho $environment PATH=/nonexistent $provider hold true
expect -exact $message
send "\r"
expect eof

set result [wait]
set status [lindex $result 3]
if {$status != 0} {
  error "expected exit status 0, got $status"
}
