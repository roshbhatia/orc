#!/usr/bin/env expect
set timeout 5

set provider [lindex $argv 0]
set mode [lindex $argv 1]
set expected_status [lindex $argv 2]
set duration [lindex $argv 3]
set real_sleep [lindex $argv 4]
set message "Command exited with $expected_status. Press Enter to close."

# Keep a controlling terminal while reproducing Zmx's closed standard input.
set child {"$1" "$2"; exit "$3"}
spawn -noecho bash -c {exec </dev/null; exec bash "$1" "$2" bash -c "$3" hold-child "$4" "$5" "$6"} hold-test $provider $mode $child $real_sleep $duration $expected_status
if {$mode eq "hold"} {
  expect {
    -exact $message {send "\r"}
    eof {error "hold closed before its exit prompt"}
    timeout {error "hold timed out waiting for its exit prompt"}
  }
  expect eof
} elseif {$mode eq "run"} {
  expect {
    -glob "*Press Enter to close.*" {error "run unexpectedly held its exit result"}
    eof {}
    timeout {error "run timed out waiting for the command to close"}
  }
} else {
  error "unknown mode: $mode"
}

set result [wait]
set status [lindex $result 3]
if {$status != $expected_status} {
  error "expected exit status $expected_status, got $status"
}
