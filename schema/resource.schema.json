        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "successCriteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "WorkflowSpec": {
      "additionalProperties": false,
      "properties": {
        "expectedOutput": {
          "minLength": 1,
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/WorkflowStage"
          },
          "type": "array"
        },
        "successCriteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "stages"
      ],
      "type": "object"
    },
    "WorkflowStage": {
      "additionalProperties": false,
      "properties": {
