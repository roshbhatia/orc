{
  "$defs": {
    "ActionSpec": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "minLength": 1,
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "ArtifactReference": {
      "properties": {
        "digest": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size",
        "mediaType"
      ],
      "type": "object"
    },
    "ArtifactSpec": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "content"
          ]
        },
        {
          "required": [
            "digest",
            "size"
          ]
        }
      ],
      "properties": {
        "content": {},
        "digest": {
          "pattern": "^sha256:[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "mediaType": {
          "minLength": 1,
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "EventBindingSpec": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/ActionSpec"
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "eventTypes": {
          "items": {
            "enum": [
              "Normal",
              "Warning"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/InputValue"
          },
          "type": "object"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "subjectKinds": {
          "items": {
            "enum": [
              "Workflow",
              "Run",
              "Session",
              "Execution",
              "EventBinding",
              "Artifact"
            ],
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "ExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "additionalProperties": {
            "$ref": "#/$defs/ActionSpec"
          },
          "propertyNames": {
            "minLength": 1
          },
          "type": "object"
        },
        "command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "cwd": {
          "minLength": 1,
          "type": "string"
        },
        "dependsOn": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "desiredState": {
          "enum": [
            "running",
            "cancelled"
          ],
          "type": "string"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "expectedOutput": {
          "minLength": 1,
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "type": "string"
        },
        "harness": {
          "minLength": 1,
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/InputValue"
          },
          "type": "object"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "runRef": {
          "minLength": 1,
          "type": "string"
        },
        "successCriteria": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "InputValue": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifactRef": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "artifactRef"
          ],
          "title": "Artifact input",
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "executionRef": {
              "minLength": 1,
              "type": "string"
            },
            "output": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "executionRef",
            "output"
          ],
          "title": "Execution output input",
          "type": "object"
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "artifactRef"
                ],
                "type": "object"
              },
              {
                "required": [
                  "executionRef"
                ],
                "type": "object"
              },
              {
                "required": [
                  "output"
                ],
                "type": "object"
              }
            ]
          },
          "title": "Literal input"
        }
      ]
    },
    "ObjectMeta": {
      "properties": {
        "createdAt": {
          "default": "1970-01-01T00:00:00Z",
          "format": "date-time",
          "type": "string"
        },
        "fieldOwners": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "generation": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "type": "object"
        },
        "name": {
          "pattern": "^[A-Za-z0-9.-]+$",
          "type": "string"
        },
        "resourceVersion": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "uid": {
          "default": "",
          "type": "string"
        },
        "updatedAt": {
          "default": "1970-01-01T00:00:00Z",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "Workflow",
        "Run",
        "Session",
        "Execution",
        "EventBinding",
        "Artifact"
      ],
      "type": "string"
    },
    "ResourceStatus": {
      "properties": {
        "deliveredEvents": {
          "default": [],
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "externalRef": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "observedGeneration": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "default": {},
          "type": "object"
        },
        "phase": {
          "default": "",
          "type": "string"
        },
        "provider": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RunSpec": {
      "additionalProperties": false,
      "properties": {
        "desiredState": {
