        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "expectedOutput": {
          "minLength": 1,
          "type": "string"
        },
        "goal": {
          "minLength": 1,
          "type": "string"
        },
        "harness": {
          "minLength": 1,
