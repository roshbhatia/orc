{
  "$defs": {
    "CacheConfig": {
      "properties": {
        "providerTtlMs": {
          "default": 30000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DaemonConfig": {
      "properties": {
        "autostart": {
          "default": true,
          "type": "boolean"
        },
        "idleShutdownSeconds": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scanIntervalMs": {
          "default": 5000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "terminationRetrySeconds": {
          "default": 60,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "LifecycleConfig": {
      "properties": {
        "idleTimeoutSeconds": {
          "default": 1800,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "runtimeTimeoutSeconds": {
          "default": 28800,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ProviderConfig": {
      "properties": {
        "directory": {
          "default": "~/.config/orc/providers",
          "type": "string"
        },
        "timeoutMs": {
          "default": 15000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "UiConfig": {
      "properties": {
        "activityRefreshMs": {
          "default": 10000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "animationFile": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "inspectorPercent": {
          "default": 28,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "reducedMotion": {
          "default": false,
          "type": "boolean"
        },
        "refreshMs": {
          "default": 5000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "WorkflowConfig": {
      "properties": {
        "autoCommit": {
          "default": true,
          "type": "boolean"
        },
        "maxDepth": {
          "default": 10,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "repository": {
          "default": "~/.local/share/orc/workflows",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cache": {
      "$ref": "#/$defs/CacheConfig",
      "default": {
        "providerTtlMs": 30000
      }
    },
    "daemon": {
      "$ref": "#/$defs/DaemonConfig",
      "default": {
        "autostart": true,
        "idleShutdownSeconds": 60,
        "scanIntervalMs": 5000,
        "terminationRetrySeconds": 60
      }
    },
    "lifecycle": {
      "$ref": "#/$defs/LifecycleConfig",
      "default": {
        "idleTimeoutSeconds": 1800,
        "runtimeTimeoutSeconds": 28800
      }
    },
    "providers": {
      "$ref": "#/$defs/ProviderConfig",
      "default": {
        "directory": "~/.config/orc/providers",
        "timeoutMs": 15000
      }
    },
    "ui": {
      "$ref": "#/$defs/UiConfig",
      "default": {
        "activityRefreshMs": 10000,
        "animationFile": null,
        "inspectorPercent": 28,
        "reducedMotion": false,
        "refreshMs": 5000
      }
    },
    "workflows": {
      "$ref": "#/$defs/WorkflowConfig",
      "default": {
        "autoCommit": true,
        "maxDepth": 10,
        "repository": "~/.local/share/orc/workflows"
      }
    }
  },
  "title": "Config",
  "type": "object"
}
