{
  "$defs": {
    "CacheConfig": {
      "properties": {
        "providerTtlMs": {
          "default": 30000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ProviderConfig": {
      "properties": {
        "directory": {
          "default": "/Users/roshan/.config/orc/providers",
          "type": "string"
        },
        "timeoutMs": {
          "default": 15000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "UiConfig": {
      "properties": {
        "activityRefreshMs": {
          "default": 10000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "inspectorPercent": {
          "default": 38,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "refreshMs": {
          "default": 5000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "WorkflowConfig": {
      "properties": {
        "autoCommit": {
          "default": true,
          "type": "boolean"
        },
        "maxDepth": {
          "default": 10,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "repository": {
          "default": "/Users/roshan/.local/share/orc/workflows",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cache": {
      "$ref": "#/$defs/CacheConfig",
      "default": {
        "providerTtlMs": 30000
      }
    },
    "providers": {
      "$ref": "#/$defs/ProviderConfig",
      "default": {
        "directory": "/Users/roshan/.config/orc/providers",
        "timeoutMs": 15000
      }
    },
    "ui": {
      "$ref": "#/$defs/UiConfig",
      "default": {
        "activityRefreshMs": 10000,
        "inspectorPercent": 38,
        "refreshMs": 5000
      }
    },
    "workflows": {
      "$ref": "#/$defs/WorkflowConfig",
      "default": {
        "autoCommit": true,
        "maxDepth": 10,
        "repository": "/Users/roshan/.local/share/orc/workflows"
      }
    }
  },
  "title": "Config",
  "type": "object"
}
