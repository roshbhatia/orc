{
  "$defs": {
    "Capability": {
      "enum": [
        "changes.inspect",
        "session.attach",
        "session.bind",
        "session.describe",
        "session.inspect",
        "session.launch",
        "session.persist",
        "session.stop",
        "terminal.open",
        "execution.run",
        "execution.cancel",
        "execution.status",
        "execution.logs",
        "session.guide"
      ],
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "persistence",
        "display",
        "activity",
        "changes",
        "harness",
        "execution",
        "integration"
      ],
      "type": "string"
    },
    "Requirements": {
      "properties": {
        "commands": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "environment": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "additionalProperties": false,
      "default": {},
      "properties": {
        "changes.inspect": {
          "type": "string"
        },
        "execution.cancel": {
          "type": "string"
        },
        "execution.logs": {
          "type": "string"
        },
        "execution.run": {
          "type": "string"
        },
        "execution.status": {
          "type": "string"
        },
        "session.attach": {
          "type": "string"
        },
        "session.bind": {
          "type": "string"
        },
        "session.describe": {
          "type": "string"
        },
        "session.guide": {
          "type": "string"
        },
        "session.inspect": {
          "type": "string"
        },
        "session.launch": {
          "type": "string"
        },
        "session.persist": {
          "type": "string"
        },
        "session.stop": {
          "type": "string"
        },
        "terminal.open": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "capabilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array"
    },
    "command": {
      "type": "string"
    },
    "description": {
      "default": "Orc provider",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ProviderKind",
      "default": "integration"
    },
    "name": {
      "type": "string"
    },
    "priority": {
      "default": 0,
      "format": "int64",
      "type": "integer"
    },
    "requires": {
      "$ref": "#/$defs/Requirements",
      "default": {
        "commands": [],
        "environment": [],
        "paths": []
      }
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "name",
    "command"
  ],
  "title": "Manifest",
  "type": "object"
}
