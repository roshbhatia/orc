{
  "name": "example",
  "version": "0.1.0",
  "type": "module",
  "module": "src/main.ts",
  "bin": {
    "example": "src/main.ts"
  },
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun --format esm",
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "nix:lock": "bunx bun2nix -o bun.nix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@roshbhatia/ts-utils": "https://github.com/roshbhatia/ts-utils/archive/refs/tags/v0.1.0.tar.gz",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "bun2nix": "2.1.2",
    "typescript": "5.9.3"
  }
}
